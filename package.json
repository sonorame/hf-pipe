{
  "name": "hf-pipe",
  "version": "1.4.0",
  "private": true,
  "description": "Cross-host remote control when direct TCP is blocked: Matrix to-device signaling and WebRTC TURN/TCP RPC.",
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "tsc && node scripts/test.mjs",
    "start": "node scripts/run.mjs",
    "start:dirty": "node scripts/run.mjs dirty",
    "start:clean": "node scripts/run.mjs clean",
    "login": "node src/login.mjs",
    "doctor": "node src/hop-doctor.mjs",
    "diagnose": "node src/diagnose.mjs",
    "release:build": "node scripts/build-release.mjs",
    "release:deploy": "node scripts/deploy-release.mjs",
    "soak": "node scripts/soak-live.mjs",
    "mcp": "node src/hf-clean-mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.16.0",
    "matrix-js-sdk": "^38.2.0",
    "undici": "^7.29.1",
    "werift": "^0.24.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.0"
  }
}
