# Copy to .env on each host. Do not commit .env.

# dirty = operator / Cursor / RPC
# clean = remote host that runs shell, files, screenshot
HF_SIDE=dirty

MATRIX_HOMESERVER_URL=https://matrix.example.com
# MAS / OIDC issuer. Default: {MATRIX_HOMESERVER_URL}/auth/
# MATRIX_OIDC_ISSUER=https://matrix.example.com/auth/

# Optional. Login writes this file if empty.
# MATRIX_USER_ID=@you:matrix.example.com
# MATRIX_SESSION_FILE=
# HF_SECRETS_DIR=
# MATRIX_DATA_DIR=
# HF_LOCAL_DIR=
# HF_CLEAN_PROJECT=
# HF_LAB_SCRIPT=
# HF_LAB_CONFIG=

HF_RPC_BIND=127.0.0.1
HF_RPC_PORT=18765
HF_EVENT_TYPE=org.hf.pipe

# Device display names used to find the peer. Login sets HF_DEVICE_NAME.
# HF_DEVICE_NAME=hf-dirty
# HF_PEER_CLEAN_NAME=hf-matrix
# HF_PEER_DIRTY_NAME=hf-dirty
# HF_PEER_DEVICE=

HF_SYNC_DEAD_MS=120000

# Temp queues (outbox / mxinbox / shots / work). 0 = delete on next sweep.
# In-flight outbox json is kept at least 20s. CursorMCP also runs src/temp-sweep.mjs.
HF_TEMP_KEEP_MS=0
HF_TEMP_SWEEP_MS=30000

# host=IPv4, comma-separated. Use when OS DNS is dead after hibernate.
# HF_DNS_PIN=matrix.example.com=203.0.113.10

# HF_OPEN_BROWSER=0
# HF_RPC_URL=http://127.0.0.1:18765
# HTTP CONNECT for native Cursor on clean. Must not equal HF_RPC_PORT.
# HF_EGRESS_PORT=18766
# Handshake version. Git default is 3. A live pack may pin 2 until both sides activate one release.
# HF_PROTOCOL_VERSION=3
