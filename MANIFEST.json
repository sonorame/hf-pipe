{
  "name": "hf-pipe",
  "version": "1.2.0",
  "summary": "Dirty-to-clean remote hop: Matrix to-device signaling, WebRTC TURN/TCP RPC, filesystem, shell, screenshot, watchdog.",
  "event_type": "org.hf.pipe",
  "rpc": {
    "bind": "127.0.0.1",
    "port": 18765
  },
  "paths": {
    "secrets": "~/.hf-pipe/secrets",
    "session": "~/.hf-pipe/secrets/matrix-session.json",
    "data": "~/.hf-pipe/data/{dirty,clean}",
    "local": "~/.hf-pipe/local",
    "shots": "~/.hf-pipe/local/shots"
  },
  "jobs": [
    "ping",
    "context",
    "lab",
    "shell",
    "list",
    "tree",
    "glob",
    "grep",
    "read",
    "write",
    "screenshot"
  ],
  "mcp": {
    "server": "clean-pc",
    "tools": [
      "clean_status",
      "clean_context",
      "clean_lab",
      "clean_shell",
      "clean_list",
      "clean_tree",
      "clean_read",
      "clean_write",
      "clean_glob",
      "clean_grep",
      "clean_screenshot"
    ]
  },
  "watchdog": {
    "sync_dead_ms": 120000
  },
  "do_not": [
    "direct TCP dirty<->clean",
    "publish RPC on a non-loopback interface",
    "Matrix room as control plane"
  ]
}
